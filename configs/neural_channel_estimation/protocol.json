{
  "schema_version": 2,
  "name": "neural_channel_estimation",
  "paths": {
    "training_datasets": "datasets/neural_channel_estimation",
    "test_datasets": "datasets/neural_channel_estimation",
    "checkpoints": "checkpoints/neural_channel_estimation",
    "results": "results/neural_channel_estimation"
  },
  "dataset_root_seed": 7301,
  "ofdm": {
    "fft_size": 64,
    "cp_length": 16,
    "pilot_spacing": 4,
    "modulation_order": 4,
    "noise_mode": "fixed",
    "channel": {
      "model": "rayleigh",
      "delays": [
        0,
        1,
        3,
        6
      ],
      "decay_samples": 2.5
    }
  },
  "training_reference_range_db": [
    0.0,
    30.0
  ],
  "split_counts": {
    "debug": 2000,
    "train": 30000,
    "validation": 4000
  },
  "test_frames_per_point": 2000,
  "primary_references_db": [
    0,
    5,
    10,
    15,
    20,
    25,
    30
  ],
  "extrapolation_references_db": [
    -5,
    35
  ],
  "test_conditions": [
    {
      "name": "primary",
      "condition_id": 0,
      "kind": "unseen channels, same prior",
      "ofdm": {},
      "references": "primary_and_extrapolation"
    },
    {
      "name": "rician_k1",
      "condition_id": 1,
      "kind": "changed prior: Rician global linear K=1, LOS on delay 0, phase 0 rad, same diffuse PDP shape, expected energy 1",
      "ofdm": {
        "channel": {
          "model": "rician",
          "delays": [
            0,
            1,
            3,
            6
          ],
          "decay_samples": 2.5,
          "k_linear": 1.0,
          "los_path": 0,
          "los_phase_rad": 0.0
        }
      },
      "references": "primary"
    },
    {
      "name": "rician_k10",
      "condition_id": 2,
      "kind": "changed prior: Rician global linear K=10, LOS on delay 0, phase 0 rad, same diffuse PDP shape, expected energy 1",
      "ofdm": {
        "channel": {
          "model": "rician",
          "delays": [
            0,
            1,
            3,
            6
          ],
          "decay_samples": 2.5,
          "k_linear": 10.0,
          "los_path": 0,
          "los_phase_rad": 0.0
        }
      },
      "references": "primary"
    },
    {
      "name": "long_delay_spread",
      "condition_id": 3,
      "kind": "changed prior: Rayleigh delays 0,2,4,7,11 samples, decay 4.0 samples, CP 16 >= 11",
      "ofdm": {
        "channel": {
          "model": "rayleigh",
          "delays": [
            0,
            2,
            4,
            7,
            11
          ],
          "decay_samples": 4.0
        }
      },
      "references": "primary"
    },
    {
      "name": "pilot_spacing_2",
      "condition_id": 4,
      "kind": "changed pilot layout: spacing 2 (32 pilots), same Rayleigh prior; LS-only input carries no pilot mask",
      "ofdm": {
        "pilot_spacing": 2
      },
      "references": "primary"
    },
    {
      "name": "pilot_spacing_8",
      "condition_id": 5,
      "kind": "changed pilot layout: spacing 8 (8 pilots), same Rayleigh prior, max delay 6 < 8; LS-only input carries no pilot mask",
      "ofdm": {
        "pilot_spacing": 8
      },
      "references": "primary"
    }
  ],
  "training": {
    "optimizer": "AdamW",
    "batch_size": 256,
    "maximum_epochs": 60,
    "patience": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss": "complex MSE: mean over batch and bins of (dRe^2 + dIm^2), physical units",
    "selection": "minimum validation complex MSE; test data never used",
    "num_workers": 0
  },
  "runs": {
    "mlp": {
      "description": "simple baseline: flatten [2,64] -> 128 ReLU -> 128, direct output",
      "model": {
        "architecture": "mlp",
        "hidden": 128,
        "residual": false,
        "normalization": "none"
      },
      "seeds": [
        11,
        22,
        33
      ]
    },
    "cnn_residual": {
      "description": "main model: residual Conv1d refinement H_CNN = H_LS + correction(H_LS)",
      "model": {
        "architecture": "cnn",
        "width": 32,
        "blocks": 3,
        "kernel_size": 5,
        "activation": "relu",
        "padding": "circular",
        "residual": true,
        "zero_init_output": true,
        "normalization": "none"
      },
      "seeds": [
        11,
        22,
        33
      ]
    },
    "cnn_direct": {
      "description": "ablation: identical CNN predicting H directly, default output initialization",
      "model": {
        "architecture": "cnn",
        "width": 32,
        "blocks": 3,
        "kernel_size": 5,
        "activation": "relu",
        "padding": "circular",
        "residual": false,
        "zero_init_output": false,
        "normalization": "none"
      },
      "seeds": [
        11
      ]
    },
    "cnn_normalized": {
      "description": "ablation: residual CNN with per-channel affine normalization fitted on training inputs only",
      "model": {
        "architecture": "cnn",
        "width": 32,
        "blocks": 3,
        "kernel_size": 5,
        "activation": "relu",
        "padding": "circular",
        "residual": true,
        "zero_init_output": true,
        "normalization": "affine"
      },
      "seeds": [
        11
      ]
    }
  },
  "representative_run": "cnn_residual",
  "representative_seed": 11,
  "evaluation": {
    "equalizer": "zf",
    "bootstrap_replicates": 1000,
    "bootstrap_seed": 9107,
    "example_reference_db": 10,
    "example_frame": 0
  },
  "policy": "Architecture, budgets, seeds and every test condition were fixed before any test result was computed. Validation alone selects checkpoints. Test frames are identical across receivers, seeds and ablations.",
  "main_runs": [
    "mlp",
    "cnn_residual"
  ]
}
